# ===================================
# Assistant IA - Analyse d'Images
# ===================================

# Clé API OpenAI pour l'analyse d'images avec GPT-4 Vision
# Obtenir une clé sur : https://platform.openai.com/api-keys
# Coût estimé : ~$0.01 par analyse
# Si non configuré, l'assistant fonctionne en mode démo (analyse basique)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# API Mammouth
MAMMOUTH_API_KEY=TO_DEFINE
MAMMOUTH_BASE_URL=https://api.mammouth.ai
MAMMOUTH_MODEL=TO_DEFINE

# PEXELS
PEXELS_API_KEY=TO_DEFINE
